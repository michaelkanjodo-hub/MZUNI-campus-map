{
  "name": "mzuni-campus-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first campus navigation for Mzuzu University students, staff and visitors.",
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "check:data": "node scripts/validate-data.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
